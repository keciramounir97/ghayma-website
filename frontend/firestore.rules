rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalog & content (read by all, written by admin/backend)
    match /books/{bookId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if true;
    }

    match /challenge_posts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    // Community interactions: comments & likes
    match /article_comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.content is string && request.resource.data.content.size() > 0;
      allow update, delete: if true;
    }

    match /challenge_comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.content is string && request.resource.data.content.size() > 0;
      allow update, delete: if true;
    }

    match /challenge_likes/{likeId} {
      allow read, write: if true;
    }

    match /user_routines/{routineId} {
      allow read, write: if true;
    }

    // Orders & Messages: Public creation only, admin management
    match /orders/{orderId} {
      allow create: if request.resource.data.clientName is string && request.resource.data.clientPhone is string;
      allow read, update, delete: if true;
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.name is string && request.resource.data.message is string;
      allow read, update, delete: if true;
    }

    match /analytics/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
